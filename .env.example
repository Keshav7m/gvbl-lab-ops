# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For local development with docker-compose:
DATABASE_URL="postgresql://gvbl:gvbl_password@localhost:5432/gvbl_lab_ops?schema=public"

# ─── Application behaviour ───────────────────────────────────────────────────
# Time zone used for "Today", "This week", dates in PDFs and Excel.
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

# Report numbers look like GVBL-NGS-2026-0001
REPORT_NUMBER_PREFIX="GVBL-NGS"

# ─── Seeding ─────────────────────────────────────────────────────────────────
# `npm run db:seed` inserts clearly-marked demo reports when this is "true".
# Remove them later with `npm run db:remove-demo`.
SEED_DEMO_DATA="true"
